<mxfile host="drawio"><diagram name="Architecture" id="arch"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Retina emulator (fixed, outside the proposed architecture)" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="250" height="1250" as="geometry"/></mxCell><mxCell id="n2" value="LGN" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#f1f8f0;strokeColor=#82b366;fontColor=#4f7a38;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="120" height="1250" as="geometry"/></mxCell><mxCell id="n3" value="Shared early vision: V1 and V2 (stream-specific compartments)" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#fbfbfb;strokeColor=#aaaaaa;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="960" height="1250" as="geometry"/></mxCell><mxCell id="n4" value="VENTRAL STREAM — what (identity, location-preserving)" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontColor=#3d5f8f;" vertex="1" parent="1"><mxGeometry x="1740" y="60" width="1140" height="740" as="geometry"/></mxCell><mxCell id="n5" value="DORSAL STREAM — where / how (motion, depth)" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#fff8ef;strokeColor=#d79b00;fontColor=#9a6b00;" vertex="1" parent="1"><mxGeometry x="1740" y="830" width="1140" height="480" as="geometry"/></mxCell><mxCell id="n6" value="Selection, goal and memory" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fillColor=#faf5fc;strokeColor=#9673a6;fontColor=#6c4d80;" vertex="1" parent="1"><mxGeometry x="2900" y="60" width="640" height="1250" as="geometry"/></mxCell><mxCell id="n7" value="Anatomy of the proposed bio-inspired spiking visual system — wave-based TTFS, ≤ 1 spike per neuron per wave" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2" width="2400" height="24" as="geometry"/></mxCell><mxCell id="n8" value="Each wave: T = 15 time steps per stage · non-leaky IF neurons · lateral inhibition (feature-WTA) in every S layer · wave 1 = pure feed-forward (ultra-rapid) · dashed red = feedback applied in wave n+1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="2600" height="18" as="geometry"/></mxCell><mxCell id="n9" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="150" height="150" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="58" y="518" width="120" height="120" as="geometry"/></mxCell><mxCell id="n11" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="74" y="534" width="96" height="96" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="150" height="150" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Input image / video frame&lt;/b&gt;&lt;br&gt;RGB pyramid 256² · 181² · 128²&lt;br&gt;(each level ÷ √2)&lt;br&gt;L ≈ R, M ≈ G, S ≈ B, Y = (L+M)/2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="200" height="70" as="geometry"/></mxCell><mxCell id="n14" value="" style="shape=cube;html=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="40" height="200" as="geometry"/></mxCell><mxCell id="n15" value="Retina · Parvo (P)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="116" width="160" height="32" as="geometry"/></mxCell><mxCell id="n16" value="4" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="352" width="40" height="16" as="geometry"/></mxCell><mxCell id="n17" value="L/M opponent DoG, σ&lt;sub&gt;c&lt;/sub&gt;=1, σ&lt;sub&gt;s&lt;/sub&gt;=3σ&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;L+/M− and M+/L− × ON/OFF&lt;br&gt;divisive norm. r = ⌊D⌋₊/(ε + G∗Y)&lt;br&gt;t = T(1 − r/r&lt;sub&gt;max&lt;/sub&gt;), no spike if r &amp;lt; θ&lt;sub&gt;in&lt;/sub&gt;&lt;br&gt;out 4 × 256² per scale" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="305" y="370" width="165" height="120" as="geometry"/></mxCell><mxCell id="n18" value="" style="shape=cube;html=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="32" height="150" as="geometry"/></mxCell><mxCell id="n19" value="Retina · Konio (K)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="236" y="496" width="160" height="32" as="geometry"/></mxCell><mxCell id="n20" value="2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="682" width="32" height="16" as="geometry"/></mxCell><mxCell id="n21" value="S − Y, coextensive, σ&lt;sub&gt;k&lt;/sub&gt;=2σ&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;ON/OFF · same latency code&lt;br&gt;out 2 × 256² per scale" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="305" y="700" width="165" height="70" as="geometry"/></mxCell><mxCell id="n22" value="" style="shape=cube;html=1;size=18;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="930" width="32" height="200" as="geometry"/></mxCell><mxCell id="n23" value="Retina · Magno (M)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="236" y="896" width="160" height="32" as="geometry"/></mxCell><mxCell id="n24" value="2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1132" width="32" height="16" as="geometry"/></mxCell><mxCell id="n25" value="events: |log Y − log Y&lt;sub&gt;ref&lt;/sub&gt;| ≥ C, C = 0.15–0.3&lt;br&gt;+ DoG σ=3σ&lt;sub&gt;c&lt;/sub&gt; · ON/OFF&lt;br&gt;static input: microsaccade shifts 1–2 px × 4 dirs&lt;br&gt;out 2 × 256² per scale&lt;br&gt;&lt;b&gt;Total: 8 maps × 3 scales = 24&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="305" y="1150" width="165" height="130" as="geometry"/></mxCell><mxCell id="n26" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="171" y="553" width="14" height="20" as="geometry"/></mxCell><mxCell id="n27" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="326" y="256" width="6" height="6" as="geometry"/></mxCell><mxCell id="n28" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="DoG" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="212" y="388" width="90" height="16" as="geometry"/></mxCell><mxCell id="n31" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="171" y="583" width="14" height="20" as="geometry"/></mxCell><mxCell id="n32" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="322" y="611" width="6" height="6" as="geometry"/></mxCell><mxCell id="n33" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="DoG" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="210" y="580" width="90" height="16" as="geometry"/></mxCell><mxCell id="n36" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="171" y="613" width="14" height="20" as="geometry"/></mxCell><mxCell id="n37" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="322" y="1036" width="6" height="6" as="geometry"/></mxCell><mxCell id="n38" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n36" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n36" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="events+DoG" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="210" y="808" width="90" height="16" as="geometry"/></mxCell><mxCell id="n41" value="" style="shape=cube;html=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="565" y="150" width="26" height="200" as="geometry"/></mxCell><mxCell id="n42" value="LGN · P" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="498" y="116" width="160" height="32" as="geometry"/></mxCell><mxCell id="n43" value="4" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565" y="352" width="26" height="16" as="geometry"/></mxCell><mxCell id="n44" value="" style="shape=cube;html=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="565" y="530" width="24" height="150" as="geometry"/></mxCell><mxCell id="n45" value="LGN · K" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="497" y="496" width="160" height="32" as="geometry"/></mxCell><mxCell id="n46" value="2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565" y="682" width="24" height="16" as="geometry"/></mxCell><mxCell id="n47" value="" style="shape=cube;html=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="565" y="930" width="26" height="200" as="geometry"/></mxCell><mxCell id="n48" value="LGN · M" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="498" y="896" width="160" height="32" as="geometry"/></mxCell><mxCell id="n49" value="2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="565" y="1132" width="26" height="16" as="geometry"/></mxCell><mxCell id="n50" value="1:1 relay, w = 1 (no learning)&lt;br&gt;t&lt;sub&gt;out&lt;/sub&gt; = clip(t&lt;sub&gt;in&lt;/sub&gt; − δ·a(x), 0, T), δ = 3&lt;br&gt;a&amp;gt;0 attended → earlier · a&amp;lt;0 TRN suppression&lt;br&gt;fine scale gated outside a(x): virtual fovea" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="522" y="710" width="116" height="200" as="geometry"/></mxCell><mxCell id="n51" value="1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;" edge="1" parent="1" source="n14" target="n41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n52" value="1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;" edge="1" parent="1" source="n18" target="n44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n53" value="1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;" edge="1" parent="1" source="n22" target="n47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n54" value="" style="shape=cube;html=1;size=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="60" height="280" as="geometry"/></mxCell><mxCell id="n55" value="V1 · S1 (simple) · WTA" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="116" width="160" height="32" as="geometry"/></mxCell><mxCell id="n56" value="12" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="432" width="60" height="16" as="geometry"/></mxCell><mxCell id="n57" value="12 maps, kernel 5×5×6 (P4 ⊕ K2), stride 1, pad 2&lt;br&gt;&lt;b&gt;W&lt;sub&gt;S1&lt;/sub&gt;: 12×6×5×5 = 1,800&lt;/b&gt;, shared over x and scales&lt;br&gt;non-leaky IF, threshold θ&lt;sub&gt;1&lt;/sub&gt;, ≤1 spike/wave&lt;br&gt;feature-WTA per position · k-WTA when learning&lt;br&gt;flat STDP (a⁺≈0.004, a⁻≈0.003) or fixed Gabor baseline&lt;br&gt;out 12 × 256² per scale" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="745" y="450" width="230" height="110" as="geometry"/></mxCell><mxCell id="n58" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="581" y="240" width="14" height="20" as="geometry"/></mxCell><mxCell id="n59" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="866" y="296" width="6" height="6" as="geometry"/></mxCell><mxCell id="n60" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n58" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n61" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n58" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n62" value="5×5" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="687" y="251" width="90" height="16" as="geometry"/></mxCell><mxCell id="n63" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="580" y="604" width="14" height="20" as="geometry"/></mxCell><mxCell id="n64" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="866" y="296" width="6" height="6" as="geometry"/></mxCell><mxCell id="n65" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n63" target="n64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n66" value="" style="endArrow=none;html=1;str