><mxCell id="n179" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n176" target="n177"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n180" value="3×3" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2179" y="304" width="90" height="16" as="geometry"/></mxCell><mxCell id="n181" value="" style="shape=cube;html=1;size=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2500" y="280" width="130" height="75" as="geometry"/></mxCell><mxCell id="n182" value="IT · C4" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2485" y="246" width="160" height="32" as="geometry"/></mxCell><mxCell id="n183" value="128" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2500" y="357" width="130" height="16" as="geometry"/></mxCell><mxCell id="n184" value="max-pool 2×2 → 128 × 16²&lt;br&gt;retinotopic IT map&lt;br&gt;(no global pooling: location kept)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2490" y="375" width="150" height="60" as="geometry"/></mxCell><mxCell id="n185" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="2340" y="318" width="10" height="12" as="geometry"/></mxCell><mxCell id="n186" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="2571" y="324" width="6" height="6" as="geometry"/></mxCell><mxCell id="n187" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n185" target="n186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n188" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n185" target="n186"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n189" value="2×2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2417" y="304" width="90" height="16" as="geometry"/></mxCell><mxCell id="n190" value="" style="shape=cube;html=1;size=18;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2740" y="280" width="60" height="75" as="geometry"/></mxCell><mxCell id="n191" value="N&lt;sub&gt;c&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2740" y="357" width="60" height="16" as="geometry"/></mxCell><mxCell id="n192" value="&lt;b&gt;Location-wise readout D&lt;sub&gt;c&lt;/sub&gt;(u)&lt;/b&gt;&lt;br&gt;N&lt;sub&gt;c&lt;/sub&gt; class maps, 3×3×128, shared over u&lt;br&gt;&lt;b&gt;W&lt;sub&gt;D&lt;/sub&gt;: N&lt;sub&gt;c&lt;/sub&gt;×128×3×3&lt;/b&gt;&lt;br&gt;earliest spike per cell wins · silence = background&lt;br&gt;R-STDP reward per cell: +1 if u∈Ω&lt;sub&gt;c&lt;/sub&gt;, −1 if u∈Ω&lt;sub&gt;c′&lt;/sub&gt;, −λ&lt;sub&gt;bg&lt;/sub&gt; on background&lt;br&gt;a&lt;sub&gt;r&lt;/sub&gt; ∝ N&lt;sub&gt;miss&lt;/sub&gt;/N, a&lt;sub&gt;p&lt;/sub&gt; ∝ N&lt;sub&gt;hit&lt;/sub&gt;/N · dropout" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2722" y="375" width="150" height="170" as="geometry"/></mxCell><mxCell id="n193" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="2579" y="318" width="12" height="16" as="geometry"/></mxCell><mxCell id="n194" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="2776" y="324" width="6" height="6" as="geometry"/></mxCell><mxCell id="n195" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n193" target="n194"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n196" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n193" target="n194"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n197" value="3×3" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2640" y="304" width="90" height="16" as="geometry"/></mxCell><mxCell id="n198" value="&lt;b&gt;Ultra-rapid gist (wave 1)&lt;/b&gt;&lt;br&gt;t&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;gist&lt;/sup&gt; = min&lt;sub&gt;u&lt;/sub&gt; t(D&lt;sub&gt;c&lt;/sub&gt;(u))&lt;br&gt;“is there a car in the scene?”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2540" y="96" width="200" height="64" as="geometry"/></mxCell><mxCell id="n199" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.2;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="n190" target="n198"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2752" y="128"/></Array></mxGeometry></mxCell><mxCell id="n200" value="" style="shape=cube;html=1;size=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1800" y="980" width="80" height="110" as="geometry"/></mxCell><mxCell id="n201" value="MT · pattern cells · WTA" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1760" y="946" width="160" height="32" as="geometry"/></mxCell><mxCell id="n202" value="24" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1800" y="1092" width="80" height="16" as="geometry"/></mxCell><mxCell id="n203" value="24 velocity maps (8 dirs × 3 speeds)&lt;br&gt;5×5×16 on C2k, stride 2 → 32²&lt;br&gt;&lt;b&gt;W&lt;sub&gt;MT&lt;/sub&gt;: 24×16×5×5 = 9,600&lt;/b&gt;&lt;br&gt;V&lt;sub&gt;v&lt;/sub&gt; = Σ[α s&lt;sub&gt;θ,v·n&lt;/sub&gt; − β s&lt;sub&gt;θ+π,v·n&lt;/sub&gt;] (IOC)&lt;br&gt;exponential STDP · velocity WTA → v(u)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1725" y="1110" width="230" height="90" as="geometry"/></mxCell><mxCell id="n204" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1580" y="1019" width="14" height="20" as="geometry"/></mxCell><mxCell id="n205" value="" style="ellipse;html=1;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1846" y="1041" width="6" height="6" as="geometry"/></mxCell><mxCell id="n206" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=0;" edge="1" parent="1" source="n204" target="n205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n207" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=0.8;exitX=1;exitY=1;" edge="1" parent="1" source="n204" target="n205"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n208" value="5×5, s2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1677" y="1014" width="90" height="16" as="geometry"/></mxCell><mxCell id="n209" value="" style="shape=cube;html=1;size=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2080" y="870" width="30" height="100" as="geometry"/></mxCell><mxCell id="n210" value="V3" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2015" y="836" width="160" height="32" as="geometry"/></mxCell><mxCell id="n211" value="1" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2080" y="972" width="30" height="16" as="geometry"/></mxCell><mxCell id="n212" value="MC = ‖v − v̄&lt;sub&gt;surr&lt;/sub&gt;‖&lt;br&gt;centre 3×3, surround 9×9 → 32²&lt;br&gt;moving-object salience and mask" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2000" y="990" width="190" height="50" as="geometry"/></mxCell><mxCell id="n213" value="" style="shape=cube;html=1;size=18;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2080" y="1110" width="40" height="100" as="geometry"/></mxCell><mxCell id="n214" value="MST (fixed)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2020" y="1076" width="160" height="32" as="geometry"/></mxCell><mxCell id="n215" value="templates" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2080" y="1212" width="40" height="16" as="geometry"/></mxCell><mxCell id="n216" value="expansion, contraction, rotation, translation&lt;br&gt;E(x₀) = Σ v·(x−x₀)/‖x−x₀‖ → heading&lt;br&gt;looming τ = φ/φ̇ per object" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1990" y="1230" width="220" height="60" as="geometry"/></mxCell><mxCell id="n217" value="v(u)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n200" target="n209"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n218" value="v(u)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="n200" target="n213"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n219" value="&lt;b&gt;Monocular depth fusion&lt;/b&gt;&lt;br&gt;① occlusion (border ownership, V2) → order&lt;br&gt;② familiar size Z = f·H&lt;sub&gt;c&lt;/sub&gt;/h (class c from readout D)&lt;br&gt;③ height in field Z = f·h&lt;sub&gt;cam&lt;/sub&gt;/(y&lt;sub&gt;b&lt;/sub&gt; − y&lt;sub&gt;h&lt;/sub&gt;)&lt;br&gt;④ parallax Z = f·T&lt;sub&gt;⊥&lt;/sub&gt;/‖v&lt;sub&gt;trans&lt;/sub&gt;‖ (MST)&lt;br&gt;⑤ time-to-contact τ&lt;br&gt;Ẑ&lt;sub&gt;k&lt;/sub&gt; = Σ c&lt;sub&gt;m,k&lt;/sub&gt;Z&lt;sub&gt;m,k&lt;/sub&gt; / Σ c&lt;sub&gt;m,k&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2380" y="1060" width="300" height="140" as="geometry"/></mxCell><mxCell id="n220" value="heading, T⊥, τ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="n213" target="n219"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n221" value="occlusion (B±)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.85;entryX=0.47;entryY=0;strokeColor=#888888;fontColor=#666666;" edge="1" parent="1" source="n99" target="n219"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="577"/><mxPoint x="1460" y="815"/><mxPoint x="2520" y="815"/></Array></mxGeometry></mxCell><mxCell id="n222" value="&lt;b&gt;Attention map → LGN&lt;/b&gt;&lt;br&gt;a(x) = clip(Σ&lt;sub&gt;k&lt;/sub&gt; exp(−‖x−p&lt;sub&gt;k&lt;/sub&gt;‖²/2ρ&lt;sub&gt;k&lt;/sub&gt;²) − γ, −1, 1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2920" y="100" width="300" height="64" as="geometry"/></mxCell><mxCell id="n223" value="" style="shape=cube;html=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2960" y="300" width="40" height="110" as="geometry"/></mxCell><mxCell id="n224" value="1 (32²)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2960" y="412" width="40" height="16" as="geometry"/></mxCell><mxCell id="n225" value="&lt;b&gt;Priority map (LIP)&lt;/b&gt;&lt;br&gt;P = α&lt;sub&gt;b&lt;/sub&gt;·S + α&lt;sub&gt;t&lt;/sub&gt;·F&lt;sub&gt;g&lt;/sub&gt; − α&lt;sub&gt;r&lt;/sub&gt;·R&lt;br&gt;S: colour/orientation + motion contrast&lt;br&gt;F&lt;sub&gt;g&lt;/sub&gt;: goal-class readout · R: inhibition of return&lt;br&gt;k-WTA, inhibition radius r → up to K objects&lt;br&gt;&lt;b&gt;replaces NMS (inside the network)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2905" y="430" width="240" height="100" as="geometry"/></mxCell><mxCell id="n226" value="&lt;b&gt;PFC · goal + working memory&lt;/b&gt;&lt;br&gt;goal g → F&lt;sub&gt;g&lt;/sub&gt; (top-down bias)&lt;br&gt;object files j: p&lt;sub&gt;j&lt;/sub&gt;, v&lt;sub&gt;j&lt;/sub&gt;, f&lt;sub&gt;j&lt;/sub&gt; (IT features), id&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;cost(k,j) = ‖p&lt;sub&gt;k&lt;/sub&gt; − (p&lt;sub&gt;j&lt;/sub&gt; + v&lt;sub&gt;j&lt;/sub&gt;Δt)‖ + λ(1 − sim(f&lt;sub&gt;k&lt;/sub&gt;, f&lt;sub&gt;j&lt;/sub&gt;))&lt;br&gt;unmatched slot: predicted, kept N waves (object permanence)&lt;br&gt;issues reward r for R-STDP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2920" y="600" width="400" height="160" as="geometry"/></mxCell><mxCell id="n227" value="&lt;b&gt;Output: object tokens (every wave)&lt;/b&gt;&lt;br&gt;o&lt;sub&gt;k&lt;/sub&gt; = (p&lt;sub&gt;k&lt;/sub&gt;, M&lt;sub&gt;k&lt;/sub&gt;, c&lt;sub&gt;k&lt;/sub&gt;, Ẑ&lt;sub&gt;k&lt;/sub&gt;, v&lt;sub&gt;k&lt;/sub&gt;, τ&lt;sub&gt;k&lt;/sub&gt;, id&lt;sub&gt;k&lt;/sub&gt;)&lt;br&gt;mask M&lt;sub&gt;k&lt;/sub&gt;: grouping from p&lt;sub&gt;k&lt;/sub&gt; along B± (phase 5)&lt;br&gt;box for mAP = min/max of M&lt;sub&gt;k&lt;/sub&gt; (never a training target)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2920" y="1070" width="400" height="120" as="geometry"/></mxCell><mxCell id="n228" value="class maps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.3;" edge="1" parent="1" source="n190" target="n223"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n229" value="motion salience" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="n209" target="n223"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2888" y="920"/><mxPoint x="2888" y="383"/></Array></mxGeometry></mxCell><mxCell id="n230" value="selected p&lt;sub&gt;k&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="n223" target="n222"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n231" value="K objects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.8;entryX=0.65;entryY=0;" edge="1" parent="1" source="n223" target="n226"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3180" y="388"/></Array></mxGeometry></mxCell><mxCell id="n232" value="IT features f&lt;sub&gt;k&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.85;entryX=0;entryY=0.3;strokeColor=#888888;fontColor=#666666;" edge="1" parent="1" source="n181" target="n226"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2712" y="345"/><mxPoint x="2712" y="648"/></Array></mxGeometry></mxCell><mxCell id="n233" value="Ẑ&lt;sub&gt;k&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n219" target="n227"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n234" value="tokens with id&lt;sub&gt;k&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n226" target="n227"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n235" value="ATTENTION FEEDBACK a(x) → all three LGN sheets (applied in wave n+1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" edge="1" parent="1" source="n222" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3070" y="52"/><mxPoint x="580" y="52"/></Array></mxGeometry></mxCell><mxCell id="n236" value="border-ownership evidence Φ± (wave n+1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0;exitY=0.9;entryX=1;entryY=0.25;dashed=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" edge="1" parent="1" source="n149" target="n99"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="385"/><mxPoint x="1470" y="470"/></Array></mxGeometry></mxCell><mxCell id="n237" value="goal g" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.85;exitY=0;entryX=1;entryY=0.3;dashed=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" edge="1" parent="1" source="n226" target="n223"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3260" y="333"/></Array></mxGeometry></mxCell><mxCell id="n238" value="reward r (R-STDP)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;exitX=0.925;exitY=0;entryX=0.5;entryY=0;dashed=1;strokeColor=#2e7d32;strokeWidth=2;fontColor=#2e7d32;" edge="1" parent="1" source="n226" target="n190"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3290" y="210"/><mxPoint x="2770" y="210"/></Array></mxGeometry></mxCell><mxCell id="n239" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1500" height="150" as="geometry"/></mxCell><mxCell id="n240" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1346" width="100" height="20" as="geometry"/></mxCell><mxCell id="n241" value="" style="shape=cube;html=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="1380" width="24" height="50" as="geometry"/></mxCell><mxCell id="n242" value="stack of n spiking feature maps&lt;br&gt;(n below the slab)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="95" y="1385" width="190" height="40" as="geometry"/></mxCell><mxCell id="n243" value="" style="html=1;fillColor=none;dashed=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="1382" width="14" height="20" as="geometry"/></mxCell><mxCell id="n244" value="receptive-field window&lt;br&gt;(conv kernel / pooling window)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="335" y="1380" width="200" height="40" as="geometry"/></mxCell><mxCell id="n245" value="thin lines = spiking synapses&lt;br&gt;(window → one target neuron)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="1380" width="200" height="40" as="geometry"/></mxCell><mxCell id="n246" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;- - -  red dashed&lt;/b&gt;&lt;/font&gt; = feedback, applied in wave n+1&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;&lt;b&gt;- - -  green dashed&lt;/b&gt;&lt;/font&gt; = reward signal (R-STDP)&lt;br&gt;solid arrow = module output · grey = auxiliary input" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="1376" width="380" height="60" as="geometry"/></mxCell><mxCell id="n247" value="&lt;b&gt;Colours:&lt;/b&gt; grey retina emulator (fixed) · green LGN relay (fixed) · blue ventral / form-colour · orange dorsal / motion · purple selection, attention, PFC · yellow outputs&lt;br&gt;&lt;b&gt;Learning:&lt;/b&gt; flat STDP in S1–S4 and S2*, exponential STDP in motion path, R-STDP in IT fine-tune and readout, fixed MST templates; adaptive threshold θ&lt;sub&gt;i&lt;/sub&gt; ← θ&lt;sub&gt;i&lt;/sub&gt; + η&lt;sub&gt;θ&lt;/sub&gt;(z&lt;sub&gt;i&lt;/sub&gt; − ρ) in every S layer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="1440" width="1460" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>