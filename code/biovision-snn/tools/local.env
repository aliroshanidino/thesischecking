# Shared settings for the laptop tools (DECISIONS D15). Sourced by tools/*_local.sh and run_local.sh.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="${BIOVISION_WORK:-$(cd "$REPO/.." && pwd)/work}"
RAW="${BIOVISION_RAW:-$(cd "$REPO/.." && pwd)/download/datasets}"
PY="$REPO/.venv/Scripts/python"
WORK_CAP_GB=10            # stop and ask above this (D15)
MIN_FREE_GB=5             # keep at least this free on the drive
