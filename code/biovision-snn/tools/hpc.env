# Shared settings for tools/*.sh (sourced by bash on the laptop). No secrets in this file.
# See DECISIONS.md D1-D7.
HPC=hpc                          # ssh alias in ~/.ssh/config -> kut@<HPC-IP>
HPC_ROOT=/home/kut/biovision
HPC_VENV=$HPC_ROOT/venv
HPC_PY=$HPC_VENV/bin/python

DISK_CAP_GB=60                   # hard cap for everything under HPC_ROOT
DISK_STOP_GB=50                  # stop and ask the user above this

MAX_THREADS=12                   # total thread budget for all our jobs on kut (shared machine)
DEFAULT_THREADS=8
NICE=10
